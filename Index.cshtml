@page
@model IndexModel

<h1>Micro Blog</h1>

<p>
    <a asp-page="/Create">Create a New Post</a>
</p>

@if (Model.Posts.Count == 0)
{
    <p>No posts have been created yet.</p>
}
else
{
    foreach (var post in Model.Posts)
    {
        <partial name="_PostCard" model="post" />
    }
}