@page
@model MicroBlog.Pages.CreateModel

<h1>Create a New Post</h1>

<form method="post">

    <div>
        <label asp-for="Post.Title"></label>
        <input asp-for="Post.Title" />
        <span asp-validation-for="Post.Title"></span>
    </div>

    <div>
        <label asp-for="Post.Body"></label>
        <textarea asp-for="Post.Body"></textarea>
        <span asp-validation-for="Post.Body"></span>
    </div>

    <button type="submit">Create Post</button>

</form>

<p>
    <a asp-page="/Index">Back to Posts</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
